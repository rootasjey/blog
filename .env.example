NUXT_AUTH_SECRET=
NUXT_SESSION_PASSWORD=
ADMIN_PASSWORD=
ADMIN_USERNAME=
USER_PASSWORD=

# Toggle AI writer UI on the client
NUXT_PUBLIC_FEATURE_AI_WRITER=true

# Workers AI is provided by the Cloudflare binding in wrangler.jsonc.
# For local node-server development, select OpenRouter and provide its key.
# AI provider selection (cloudflare|openrouter)
NUXT_AI_DEFAULT_AI_PROVIDER=cloudflare

# OpenRouter credentials
NUXT_AI_OPENROUTER_KEY=
NUXT_AI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

NUXT_OG_CACHE_RESET_KEY=
