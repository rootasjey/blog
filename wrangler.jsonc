{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "corpinot",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2025-12-31",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "corpinot",
      "database_id": "eec181bd-22ad-4d95-9841-01b61979a24e",
      "migrations_dir": "server/db/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "133e2219eb3943a29470cb7f8e71c786"
    },
    {
      "binding": "CACHE",
      "id": "36e6cc57a6374484a184cdd5ef868c23"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "r2_buckets": [
    {
      "binding": "BLOB",
      "bucket_name": "corpinot"
    }
  ],
  "routes": [
    {
      "pattern": "corpinot.cc",
      "custom_domain": true
    }
  ],
  "vars": {
    "NUXT_PUBLIC_SITE_URL": "https://corpinot.cc"
  },
  "env": {
    "staging": {
      "name": "corpinot-staging",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "staging-blog.corpinot.cc",
          "custom_domain": true
        }
      ],
      "compatibility_date": "2025-12-31",
      "compatibility_flags": ["nodejs_compat"],
      "triggers": {
        "crons": ["0 * * * *"]
      },
      "assets": {
        "directory": "./.output/public",
        "binding": "ASSETS"
      },
      "ai": {
        "binding": "AI"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "corpinot-staging",
          "database_id": "b666ba5e-80cf-4b1e-95f9-0ffd3ff6ea4c",
          "migrations_dir": "server/db/migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "52e58e405dc94277b974d61272b930d7"
        },
        {
          "binding": "CACHE",
          "id": "91042409f3fc45f4ad23159f27aece38"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BLOB",
          "bucket_name": "corpinot-staging"
        }
      ],
      "vars": {
        "NUXT_PUBLIC_FEATURE_AI_WRITER": "false",
        "NUXT_PUBLIC_SITE_URL": "https://staging-blog.corpinot.cc",
        "NUXT_AUTH_ORIGIN": "https://staging-blog.corpinot.cc",
        "ENVIRONMENT": "staging"
      }
    }
  }
}
